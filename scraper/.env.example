# Copy this file to .env and fill in real values when you have them.
# .env is already in the repo's .gitignore -- never commit the real file,
# never print its contents, never hardcode these values in source.

# --- Reddit OAuth app (optional) ---
# Lets reddit.py switch from the public /top.json and /new.json endpoints to
# Reddit's authenticated API, for higher rate limits. Create an app at
# https://www.reddit.com/prefs/apps (type: "script") to get these.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# --- YouTube Data API key (optional) ---
# Lets youtube_transcripts.py search for new GTA6 videos by keyword instead
# of relying on the hardcoded VIDEO_IDS seed list. Create a key at
# https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3").
YOUTUBE_API_KEY=

# --- X / Twitter API (optional) ---
# Not used by any module yet. Adding these plus a new x_twitter.py module
# (same fetch() -> list[dict] interface as the other sources) is the planned
# way to add X/Twitter coverage. Create a developer app at
# https://developer.x.com/ to get a bearer token.
X_BEARER_TOKEN=

# --- General scraper behavior ---
# Identifying User-Agent sent with every HTTP request. Replace the contact
# info below with a real one before running this anywhere but locally.
SCRAPER_USER_AGENT=egta6-fanblog-scraper/0.1 (non-commercial GTA6 fan blog aggregator; contact: you@example.com)
# Seconds to wait between requests to the same site.
SCRAPER_REQUEST_DELAY_SECONDS=2
# Comma-separated list of article URLs for article.py to fetch. Leave blank
# to use its small built-in default list.
ARTICLE_URLS=
